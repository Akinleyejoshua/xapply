# ---- AI backend ----
# gemini = Google GenAI | nvidia = NVIDIA NIM (free) | opencode = OpenCode Zen
LLM_PROVIDER=gemini

# This file is a template and is meant to be committed. Never put a real key here;
# put it in .env, which is gitignored.
#
# Keys belong here. The model itself is chosen in the dashboard under Settings and
# saved to settings.local.json, so it changes without editing this file or restarting.

# Google Gemini (key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# NVIDIA NIM (free key at https://build.nvidia.com, looks like nvapi-...)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenCode Zen (https://opencode.ai). One key reaches Claude, GPT, Gemini,
# DeepSeek, Qwen and others. Models ending in -free only work inside OpenCode's
# own client; the rest need a payment method on your workspace.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Optional starting points, used only until you pick a model in the dashboard.
# NVIDIA lists many models it has not deployed, so verify with "Check which models work".
# GEMINI_MODEL=gemini-2.5-flash
# NVIDIA_MODEL=openai/gpt-oss-20b

# ---- Execution mode ----
# true = read the whole form, work out every answer at once, fill in one pass.
# Much faster on long forms. false = one answer at a time, typed at human speed.
FILL_ALL_AT_ONCE=false
FILL_CONCURRENCY=4                    # answers worked out at the same time in that mode

# false = assisted (bot fills, human reviews + submits). true = bot submits itself.
AUTO_SUBMIT=false
MATCH_THRESHOLD=65
HEADLESS=false                        # true = never open a window at all
HIDE_BROWSER=false                    # true = no window until a posting needs you
# What to do when a CAPTCHA or login wall blocks an application:
#   wait  stop and let you deal with it (needs a window on screen)
#   show  open a window and start that posting again in it
#   skip  give up on that posting and carry on to the next
CHALLENGE_ACTION=wait

# ---- Applying by email ----
# For postings that say "send your CV to careers@example.com" instead of offering a
# form. Off by default: email is the one thing here that cannot be undone.
EMAIL_APPLY=false
EMAIL_AUTO_SEND=false                 # true sends without stopping for you to read it
# How the message leaves:
#   gmail  your signed-in Gmail, driven in the browser. No password here at all, and
#          the message lands in your real Sent folder. Run: make gmail-login
#   smtp   a mail server, which needs the settings below
EMAIL_TRANSPORT=gmail
GMAIL_URL=https://mail.google.com/mail/u/0/   # change /u/0/ for a second account

# Only needed when EMAIL_TRANSPORT=smtp
SMTP_HOST=                            # e.g. smtp.gmail.com
SMTP_PORT=587                         # 465 uses SSL directly, 587 uses STARTTLS
SMTP_USER=
SMTP_PASSWORD=                        # Gmail: an app password, not your account password
EMAIL_FROM=                           # defaults to SMTP_USER
EMAIL_REPLY_TO=                       # defaults to your profile's email

# ---- Job search ----
# Sources, comma separated. No login needed for the board APIs or aggregators:
#   greenhouse, lever, ashby   public company board APIs (companies.json)
#   remoteok, himalayas        public aggregator feeds, resolved to the real ATS link
#   google                     site: search through Playwright. Finds company boards and
#                              remembers them in companies.json. Google may refuse an
#                              automated search, and then pauses for you to clear it
#   linkedin                   Easy Apply, requires `make login`
#   urls                       read jobs.txt
SOURCES=greenhouse,ashby,lever
SEARCH_QUERIES=Full Stack Developer,Backend Engineer,Machine Learning Engineer
SEARCH_LOCATION=Remote
REMOTE_ONLY=false                     # true = drop hybrid and on-site postings
SENIORITY_LEVELS=                     # blank = any. e.g. mid,senior  (intern|junior|mid|senior|lead)
COUNTRIES=                            # blank = anywhere. e.g. Nigeria,United Kingdom
                                      # names: python main.py countries-list
POSTED_WITHIN_HOURS=72                # LinkedIn only. 0 = any time
MAX_JOBS_PER_QUERY=15                 # LinkedIn only
MAX_JOBS_PER_COMPANY=10               # cap per company board / aggregator feed
BOARD_FETCH_TIMEOUT_S=45              # give up on one board after this. Some aggregator
                                      # boards return 40 MB and take minutes
MAX_APPLICATIONS_PER_RUN=10

# ---- Resume ----
RESUME_MAX_PAGES=2                    # 1-3. One page forces heavy trimming
RESUME_MAY_DROP_EXPERIENCE=false      # true lets it drop older roles to fit
FOLLOW_COMPANIES=false

# ---- Browser ----
BROWSER_CHANNEL=chrome                # "chrome" = installed Google Chrome, empty = bundled Chromium
TIMEZONE_ID=America/Los_Angeles
DELAY_MEAN_S=1.4
DELAY_STD_S=0.5

# ---- Admin API ----
API_HOST=127.0.0.1
API_PORT=8000
ADMIN_TOKEN=change-me
