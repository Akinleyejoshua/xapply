# ---- AI backend ----
# gemini = Google GenAI.  nvidia = NVIDIA NIM, free key at https://build.nvidia.com
LLM_PROVIDER=gemini

# Google Gemini (key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA NIM (key looks like nvapi-...). Browse models: python main.py models --provider nvidia
NVIDIA_API_KEY=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
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- Execution mode ----
# false = assisted (bot fills, human reviews + submits). true = bot submits itself.
AUTO_SUBMIT=false
MATCH_THRESHOLD=65
HEADLESS=false

# ---- Job search ----
# Sources, comma separated. No login needed for the board APIs or aggregators:
#   greenhouse, lever, ashby   public company board APIs (companies.json)
#   remoteok, himalayas        public aggregator feeds, resolved to the real ATS link
#   google                     site: search through Playwright (rate-limited, last resort)
#   linkedin                   Easy Apply, requires `make login`
#   urls                       read jobs.txt
SOURCES=greenhouse,ashby,lever
SEARCH_QUERIES=Full Stack Developer,Backend Engineer,Machine Learning Engineer
SEARCH_LOCATION=Remote
REMOTE_ONLY=false
POSTED_WITHIN_HOURS=72                # LinkedIn only. 0 = any time
MAX_JOBS_PER_QUERY=15                 # LinkedIn only
MAX_JOBS_PER_COMPANY=10               # cap per company board / aggregator feed
MAX_APPLICATIONS_PER_RUN=10
FOLLOW_COMPANIES=false

# ---- Browser ----
BROWSER_CHANNEL=chrome                # "chrome" = installed Google Chrome, empty = bundled Chromium
TIMEZONE_ID=America/Los_Angeles
DELAY_MEAN_S=1.4
DELAY_STD_S=0.5

# ---- Admin API ----
API_HOST=127.0.0.1
API_PORT=8000
ADMIN_TOKEN=change-me
