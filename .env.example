# ---- Google GenAI ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Execution mode ----
# false = assisted (bot fills, human reviews + submits). true = bot submits itself.
AUTO_SUBMIT=false
MATCH_THRESHOLD=65
HEADLESS=false

# ---- Job search ----
SOURCES=linkedin                      # comma separated: linkedin, urls
SEARCH_QUERIES=Python Developer,Backend Engineer
SEARCH_LOCATION=Remote
POSTED_WITHIN_HOURS=72                # 0 = any time
MAX_JOBS_PER_QUERY=15
MAX_APPLICATIONS_PER_RUN=10
FOLLOW_COMPANIES=false

# ---- Browser ----
BROWSER_CHANNEL=chrome                # "chrome" = installed Google Chrome, empty = bundled Chromium
TIMEZONE_ID=America/Los_Angeles
DELAY_MEAN_S=1.4
DELAY_STD_S=0.5

# ---- Admin API ----
API_HOST=127.0.0.1
API_PORT=8000
ADMIN_TOKEN=change-me
